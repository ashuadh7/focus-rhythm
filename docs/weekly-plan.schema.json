{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FocusRhythm weekly plan v1",
  "description": "Structural contract. Cross-field and reference validation in WeeklyPlan.validate() is also required; see weekly-plan-format.md.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "$ref": "#/$defs/identity"
    },
    "sourceID": {
      "$ref": "#/$defs/identity"
    },
    "timeZoneIdentifier": {
      "$ref": "#/$defs/identity"
    },
    "horizon": {
      "$ref": "#/$defs/horizon"
    },
    "availability": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/availability"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "allocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/allocation"
      }
    },
    "fixedCommitments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fixedCommitment"
      }
    },
    "localState": {
      "anyOf": [
        {
          "$ref": "#/$defs/localState"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "sourceID",
    "timeZoneIdentifier",
    "horizon",
    "tasks",
    "allocations",
    "fixedCommitments"
  ],
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "\\S"
    },
    "effortSeconds": {
      "type": "number",
      "minimum": 0
    },
    "day": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timeRange": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/timestamp"
        },
        "end": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "horizon": {
      "type": "object",
      "properties": {
        "startDay": {
          "$ref": "#/$defs/day"
        },
        "endDayExclusive": {
          "$ref": "#/$defs/day"
        }
      },
      "required": [
        "startDay",
        "endDayExclusive"
      ]
    },
    "availability": {
      "type": "object",
      "properties": {
        "day": {
          "$ref": "#/$defs/day"
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timeRange"
          }
        }
      },
      "required": [
        "day",
        "windows"
      ]
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/identity"
        },
        "sourceID": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "$ref": "#/$defs/identity"
        },
        "originalEstimateSeconds": {
          "$ref": "#/$defs/effortSeconds"
        },
        "remainingEstimateSeconds": {
          "$ref": "#/$defs/effortSeconds"
        },
        "completedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "prerequisiteTaskIDs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          },
          "uniqueItems": true
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "minimumChunkSeconds": {
          "anyOf": [
            {
              "$ref": "#/$defs/effortSeconds"
            },
            {
              "type": "null"
            }
          ]
        },
        "categoryTags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        }
      },
      "required": [
        "id",
        "title",
        "originalEstimateSeconds",
        "remainingEstimateSeconds",
        "order",
        "prerequisiteTaskIDs",
        "categoryTags"
      ]
    },
    "allocation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/identity"
        },
        "taskID": {
          "$ref": "#/$defs/identity"
        },
        "preferredDay": {
          "$ref": "#/$defs/day"
        },
        "suggestedTime": {
          "anyOf": [
            {
              "$ref": "#/$defs/timeRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "plannedEffortSeconds": {
          "anyOf": [
            {
              "$ref": "#/$defs/effortSeconds"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "taskID",
        "preferredDay"
      ]
    },
    "fixedCommitment": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/identity"
        },
        "sourceID": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "$ref": "#/$defs/identity"
        },
        "time": {
          "$ref": "#/$defs/timeRange"
        }
      },
      "required": [
        "id",
        "title",
        "time"
      ]
    },
    "deferral": {
      "type": "object",
      "properties": {
        "taskID": {
          "$ref": "#/$defs/identity"
        },
        "deferredAt": {
          "$ref": "#/$defs/timestamp"
        },
        "until": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "taskID",
        "deferredAt",
        "until"
      ]
    },
    "workSegment": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "taskID": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "runID": {
          "$ref": "#/$defs/uuid"
        },
        "focusIntervalID": {
          "$ref": "#/$defs/uuid"
        },
        "time": {
          "$ref": "#/$defs/timeRange"
        }
      },
      "required": [
        "id",
        "runID",
        "focusIntervalID",
        "time"
      ]
    },
    "localState": {
      "type": "object",
      "properties": {
        "taskOrder": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identity"
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "deferrals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deferral"
          }
        },
        "workSegments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workSegment"
          }
        }
      },
      "required": [
        "deferrals",
        "workSegments"
      ]
    }
  }
}
